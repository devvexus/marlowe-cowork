[
  {
    "name": "glob",
    "description": "Find files by glob (`**/*.rs`; `!x` excludes), newest first; gitignored files are skipped.",
    "input_schema": {
      "type": "object",
      "properties": {
        "pattern": {},
        "path": {},
        "limit": {
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        }
      },
      "required": [
        "pattern"
      ]
    }
  },
  {
    "name": "grep",
    "description": "Search contents with ripgrep regex. `output_mode`: files_with_matches (default), content, count. `limit` default 250, 0 = all.",
    "input_schema": {
      "type": "object",
      "properties": {
        "pattern": {},
        "path": {},
        "glob": {},
        "type": {
          "description": "e.g. rs, py"
        },
        "output_mode": {
          "enum": [
            "files_with_matches",
            "content",
            "count"
          ]
        },
        "-A": {
          "type": "integer"
        },
        "-B": {
          "type": "integer"
        },
        "-C": {
          "type": "integer"
        },
        "-i": {
          "type": "boolean"
        },
        "multiline": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        }
      },
      "required": [
        "pattern"
      ]
    }
  },
  {
    "name": "bash",
    "description": "Run a bash command (Git Bash on Windows; no stdin). Long output keeps failures and the end unless `raw`. `timeout_ms` default 120000. `background` for servers and long builds: returns a task id and you are told when it ends; don't poll.",
    "input_schema": {
      "type": "object",
      "properties": {
        "command": {},
        "cwd": {},
        "timeout_ms": {
          "type": "integer"
        },
        "background": {
          "type": "boolean"
        },
        "label": {},
        "raw": {
          "type": "boolean"
        }
      },
      "required": [
        "command"
      ]
    }
  },
  {
    "name": "powershell",
    "description": "Run Windows PowerShell 5.1 (`;` not `&&`). Options as bash.",
    "input_schema": {
      "type": "object",
      "properties": {
        "command": {},
        "cwd": {},
        "timeout_ms": {
          "type": "integer"
        },
        "background": {
          "type": "boolean"
        },
        "label": {},
        "raw": {
          "type": "boolean"
        }
      },
      "required": [
        "command"
      ]
    }
  },
  {
    "name": "python",
    "description": "Run Python `code`, or the script at `path` with `args`. Options as bash.",
    "input_schema": {
      "type": "object",
      "properties": {
        "code": {},
        "path": {},
        "args": {
          "type": "array"
        },
        "cwd": {},
        "timeout_ms": {
          "type": "integer"
        },
        "background": {
          "type": "boolean"
        },
        "label": {},
        "raw": {
          "type": "boolean"
        }
      }
    }
  },
  {
    "name": "arxiv",
    "description": "Search arXiv: keywords, `ti:` `au:` `abs:` `cat:` fields or an id. Read a hit with web_fetch.",
    "input_schema": {
      "type": "object",
      "properties": {
        "query": {},
        "limit": {
          "type": "integer",
          "description": "default 8, max 25"
        }
      },
      "required": [
        "query"
      ]
    }
  }
]
