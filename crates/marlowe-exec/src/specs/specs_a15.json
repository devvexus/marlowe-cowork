  {
    "name": "job_output",
    "description": "Read a background job's output: what is new since your last read, or from byte offset `since` (the `next since` of a read). `filter` keeps lines matching a regex. The result ends with the job's status and the next offset.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "filter": {
          "type": "string"
        },
        "id": {
          "description": "e.g. \"j3\"",
          "type": "string"
        },
        "since": {
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    }
  },
  {
    "name": "job_watch",
    "description": "Follow a running background job: its new output lines reach you as notices between steps until a line matches `until_regex` (the watch ends and you are told) or the job exits. `filter` limits it to matching lines. A job's exit is reported without a watch.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "filter": {
          "type": "string"
        },
        "id": {
          "description": "e.g. \"j3\"",
          "type": "string"
        },
        "until_regex": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    }
  },
  {
    "name": "job_kill",
    "description": "Stop a background job and everything it started.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    }
  },
  {
    "name": "arxiv",
    "description": "Search arXiv: keywords, field queries (`ti:`, `au:`, `abs:`, `cat:`) or an id. Returns titles, authors, dates, ids, abstracts. Results are the authors' claims, not findings; read a paper with `paper`.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "max": {
          "description": "Default 8, at most 25.",
          "type": "integer"
        },
        "query": {
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    }
  },
  {
    "name": "paper",
    "description": "Read a paper from an https URL (HTML, PDF, LaTeX source) or an arXiv id: title, authors, numbered sections, abstract and text as markdown, in windows (continue with `offset`). `part: \"references\"` returns the parsed reference list with DOIs and arXiv ids.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "offset": {
          "type": "integer"
        },
        "part": {
          "enum": [
            "text",
            "references"
          ],
          "type": "string"
        },
        "url_or_arxiv_id": {
          "type": "string"
        }
      },
      "required": [
        "url_or_arxiv_id"
      ],
      "type": "object"
    }
  }
