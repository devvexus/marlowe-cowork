  {
    "name": "glob",
    "description": "List files by gitignore-style pattern, newest first (`*.rs`, `src/*.rs`, `**/x`, `!x` excludes). Hidden files are listed; ignored files are not.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "head_limit": {
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        },
        "path": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    }
  },
  {
    "name": "grep",
    "description": "Search contents with ripgrep (Rust regex). `output_mode`: files_with_matches (default), content (`path:line:text`), count. Hidden files are searched, gitignored ones are not. `head_limit` default 250, 0 for all.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "-A": {
          "type": "integer"
        },
        "-B": {
          "type": "integer"
        },
        "-C": {
          "type": "integer"
        },
        "-i": {
          "type": "boolean"
        },
        "glob": {
          "type": "string"
        },
        "head_limit": {
          "type": "integer"
        },
        "multiline": {
          "type": "boolean"
        },
        "offset": {
          "type": "integer"
        },
        "output_mode": {
          "enum": [
            "files_with_matches",
            "content",
            "count"
          ],
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "pattern"
      ],
      "type": "object"
    }
  },
  {
    "name": "bash",
    "description": "Run a command in bash (Git Bash on Windows); stdin closed. Output is capped at 30 KB (failure lines and the end; the log's path is given). Killed at `timeout_ms` (default 120000). `run_in_background` for a server or long build: you get a job id and are told when it exits.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "raw": {
          "type": "boolean"
        },
        "run_in_background": {
          "type": "boolean"
        },
        "timeout_ms": {
          "type": "integer"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    }
  },
  {
    "name": "powershell",
