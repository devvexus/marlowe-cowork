      "columns": [
        {
          "key": "members",
          "type": "list",
          "w": "M",
          "of": "string",
          "max_items": 40,
          "max_len": 12
        },
        {
          "key": "claim",
          "type": "text",
          "w": "M",
          "max_len": 240
        },
        {
          "key": "contradicts",
          "type": "list",
          "w": "M",
          "of": "string",
          "max_items": 10,
          "max_len": 12
        }
      ],
      "show": {
        "as": "table",
        "columns": [
          "claim"
        ]
      }
    },
    {
      "key": "agents",
      "type": "agents",
      "w": "C",
      "from": "agents"
    }
  ],
  "rules": [
    "ids_known",
    "claim_in_one_group",
    "omitted_become_singletons"
  ]
}
