{
  "form": "section",
  "version": 1,
  "title": "Report section",
  "item_label": "Section {data.sub}",
  "fields": [
    {
      "key": "sub",
      "type": "string",
      "w": "C",
      "show": {
        "as": "text"
      }
    },
    {
      "key": "sentences",
      "type": "table",
      "w": "M",
      "max_items": 12,
      "columns": [
        {
          "key": "text",
          "type": "text",
          "w": "M",
          "max_len": 400
        },
        {
          "key": "claims",
          "type": "list",
          "of": "integer",
          "w": "M",
          "max_items": 4
        }
      ],
      "show": {
        "as": "hidden"
      }
    },
    {
      "key": "text",
      "type": "text",
      "w": "C",
      "max_len": 4000,
      "show": {
        "as": "text",
        "lines": 6
      }
    },
    {
      "key": "end",
      "type": "enum",
      "w": "M",
      "values": [
        "END"
      ],
      "show": {
        "as": "hidden"
      }
    },
    {
      "key": "agents",
      "type": "agents",
      "w": "C",
      "from": "agents"
    }
  ],
  "rules": [
    "markers_known",
    "end_present"
  ]
}
